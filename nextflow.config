// Process-specific configs — container, cpus, memory per tool
process {
    withName: fastqc {
        container = 'docker://staphb/fastqc:0.12.1'
        cpus      = 2
        memory    = 4.GB
    }
    withName: fastqc_clean {
        container = 'docker://staphb/fastqc:0.12.1'
        cpus      = 2
        memory    = 4.GB
    }
    withName: humanscrubber {
        container = 'docker://ncbi/sra-human-scrubber:2.2.1'
        cpus      = 4
        memory    = 8.GB
    }
    withName: trimmomatic {
        container = 'docker://staphb/trimmomatic:0.40'
        cpus      = 4
        memory    = 8.GB
    }
    withName: bbtools_adapters {
        container = 'docker://staphb/bbtools:39.84'
        cpus      = 4
        memory    = 8.GB
    }
    withName: bbtools_phix {
        container = 'docker://staphb/bbtools:39.84'
        cpus      = 4
        memory    = 8.GB
    }
    withName: multiqc {
        container = 'docker://staphb/multiqc:1.34'
        cpus      = 2
        memory    = 4.GB
    }
    withName: kraken2 {
        container = 'docker://staphb/kraken2:2.17.1-viral-20251015'
        cpus      = 8
        memory    = 32.GB
    }
    withName: bwa {
        container = 'docker://staphb/ivar:1.4.4-aligners'
        cpus      = 8
        memory    = 16.GB
    }
    // bin/ script — no container, runs with conda Python
    withName: serotype_detect {
        cpus   = 1
        memory = 2.GB
    }
    withName: samtools_screen {
        container = 'docker://staphb/samtools:1.23.1'
        cpus      = 4
        memory    = 8.GB
    }
    withName: samtools_bam {
        container = 'docker://staphb/samtools:1.23.1'
        cpus      = 4
        memory    = 8.GB
    }
    withName: samtools_coverage {
        container = 'docker://staphb/samtools:1.23.1'
        cpus      = 4
        memory    = 8.GB
    }
    withName: samtools_mpileup {
        container = 'docker://staphb/samtools:1.23.1'
        cpus      = 4
        memory    = 8.GB
    }
    withName: ivar_trim {
        container = 'docker://staphb/ivar:1.4.4'
        cpus      = 4
        memory    = 8.GB
    }
    withName: ivar_variants {
        container = 'docker://staphb/ivar:1.4.4'
        cpus      = 4
        memory    = 8.GB
    }
    withName: ivar_consensus {
        container = 'docker://staphb/ivar:1.4.4'
        cpus      = 4
        memory    = 8.GB
    }
    // bin/ script — no container, runs with conda Python
    withName: qc_gate {
        cpus   = 1
        memory = 2.GB
    }
    withName: vadr_download {
        container = 'docker://staphb/vadr:1.7'
        cpus      = 2
        memory    = 4.GB
    }
    withName: vadr {
        container     = 'docker://staphb/vadr:1.7'
        cpus          = 8
        memory        = 16.GB
        errorStrategy = 'ignore'
    }
    withName: nextclade_download {
        container = 'docker://nextstrain/nextclade:3.21.2'
        cpus      = 2
        memory    = 4.GB
    }
    withName: nextclade {
        container = 'docker://nextstrain/nextclade:3.21.2'
        cpus      = 4
        memory    = 8.GB
    }
    // bin/ script — no container, runs with conda Python
    withName: summary_report {
        cpus   = 1
        memory = 2.GB
    }
}

profiles {
    standard {
        process.executor = 'local'
    }

    docker {
        docker {
            enabled    = true
            runOptions = '-u $(id -u):$(id -g)'
        }
    }

    singularity {
        singularity {
            enabled    = true
            autoMounts = true
        }
    }

    apptainer {
        apptainer {
            enabled    = true
            autoMounts = true
        }
    }
}

// Global error handling
process.errorStrategy = 'finish'
process.maxRetries    = 0
