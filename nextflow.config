// Process-specific configs — container, cpus, memory per tool
process {
    withName: kraken2 {
        container = 'docker://staphb/kraken2:2.1.3'
        cpus      = 8
        memory    = 32.GB
    }
    withName: serotype_detect {
        container = 'docker://staphb/ivar:1.3.2'  // ivar image bundles bwa + samtools
        cpus      = 8
        memory    = 16.GB
    }
    withName: fastqc {
        container = 'docker://staphb/fastqc:0.11.9'
        cpus      = 2
        memory    = 4.GB
    }
    withName: fastqc_clean {
        container = 'docker://staphb/fastqc:0.11.9'
        cpus      = 2
        memory    = 4.GB
    }
    withName: humanscrubber {
        container = 'docker://ncbi/sra-human-scrubber:1.1.2021-05-05'
        cpus      = 4
        memory    = 8.GB
    }
    withName: trimmomatic {
        container = 'docker://staphb/trimmomatic:0.39'
        cpus      = 4
        memory    = 8.GB
    }
    withName: bbtools_adapters {
        container = 'docker://staphb/bbtools:38.76'
        cpus      = 4
        memory    = 8.GB
    }
    withName: bbtools_phix {
        container = 'docker://staphb/bbtools:38.76'
        cpus      = 4
        memory    = 8.GB
    }
    withName: multiqc {
        container = 'docker://staphb/multiqc:1.8'
        cpus      = 2
        memory    = 4.GB
    }
    withName: bwa_mem {
        container = 'docker://staphb/bwa:0.7.17'
        cpus      = 8
        memory    = 16.GB
    }
    withName: samtools_bam {
        container = 'docker://staphb/samtools:1.12'
        cpus      = 4
        memory    = 8.GB
    }
    withName: samtools_coverage {
        container = 'docker://staphb/samtools:1.12'
        cpus      = 4
        memory    = 8.GB
    }
    withName: samtools_mpileup {
        container = 'docker://staphb/samtools:1.12'
        cpus      = 4
        memory    = 8.GB
    }
    withName: ivar_trim {
        container = 'docker://staphb/ivar:1.3.2'
        cpus      = 4
        memory    = 8.GB
    }
    withName: ivar_variants {
        container = 'docker://staphb/ivar:1.3.2'
        cpus      = 4
        memory    = 8.GB
    }
    withName: ivar_consensus {
        container = 'docker://staphb/ivar:1.3.2'
        cpus      = 4
        memory    = 8.GB
    }
    // bin/ script — no container, runs with conda Python
    withName: qc_gate {
        cpus   = 1
        memory = 2.GB
    }
    withName: vadr {
        container     = 'docker://staphb/vadr:1.5.1'
        cpus          = 8
        memory        = 16.GB
        errorStrategy = 'ignore'
    }
    withName: nextclade_download {
        container = 'docker://nextstrain/nextclade:3.0.0'
        cpus      = 2
        memory    = 4.GB
    }
    withName: nextclade {
        container = 'docker://nextstrain/nextclade:3.0.0'
        cpus      = 4
        memory    = 8.GB
    }
    withName: summary_report {
        cpus   = 1
        memory = 2.GB
    }
}

profiles {
    standard {
        process.executor = 'local'
    }

    docker {
        docker {
            enabled    = true
            runOptions = '-u $(id -u):$(id -g)'
        }
    }

    singularity {
        singularity {
            enabled    = true
            autoMounts = true
        }
    }

    apptainer {
        apptainer {
            enabled    = true
            autoMounts = true
        }
    }
}

// Global error handling
process.errorStrategy = 'finish'
process.maxRetries    = 0
